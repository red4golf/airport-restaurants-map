@@ -70,6 +70,29 @@ def slugify(text: str) -> str:
     return text.strip("-")
 
 
+def normalize_status(raw: str) -> str:
+    """Blank means open — keeps older seed files working unchanged."""
+    s = (raw or "").strip().lower()
+    return s if s in ("open", "closed") else "open"
+
+
+def is_open(props: dict) -> bool:
+    return props.get("status", "open") != "closed"
